# Copy to backend/.env and fill in. Never commit .env (it's in .gitignore).

# --- Claude -------------------------------------------------------------------
# The SDK also picks up an `ant auth login` profile if this is unset.
ANTHROPIC_API_KEY=
GRE_AI_ENABLED=true
GRE_CLAUDE_MODEL=claude-opus-5-5

# --- Database -----------------------------------------------------------------
# Dev: SQLite file. Supabase: Project → Connect → "Session pooler" string
# (works over IPv4), with your database password filled in. Migrations run
# automatically on startup (or run `alembic upgrade head`).
GRE_DATABASE_URL=sqlite:///./gre_prep.db
# GRE_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth ---------------------------------------------------------------------
# "dev": trusts the X-Dev-User header (local only!). "clerk": verifies Clerk
# session tokens. No Clerk secret key is needed: tokens are checked against
# Clerk's public signing keys.
GRE_AUTH_MODE=dev
# Clerk dashboard → Configure → API keys → "Frontend API URL":
# GRE_CLERK_ISSUER=https://<your-app>.clerk.accounts.dev
# GRE_CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
# Origins your frontend is served from:
# GRE_CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]

GRE_CORS_ORIGINS=["http://localhost:5173"]
