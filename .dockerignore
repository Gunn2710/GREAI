# Build context for backend/Dockerfile is the repo root; it only needs
# engine/ and backend/. Everything else, and every secret, stays out.
*
!engine
!backend

# Secrets and local state
**/.env
**/.env.*
!**/.env.example
backend/*.db

# Local environments and build output
backend/.venv
engine/build
**/*.egg-info
**/__pycache__
**/.pytest_cache
