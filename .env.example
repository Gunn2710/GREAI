# One settings file for the whole app: copy to .env (in this folder) and fill in.
# Never commit .env (it's in .gitignore). The backend, Vite and Docker Compose
# all read it. Only VITE_* values ever reach the browser.
#
# Secrets (marked SECRET) are read by backend/app/secrets_config.py; ordinary
# settings by backend/app/config.py. On Vercel, set these in the project's
# environment variables instead.

# --- Claude -------------------------------------------------------------------
# SECRET. Optional: without it the SDK uses an `ant auth login` profile.
ANTHROPIC_API_KEY=
GRE_AI_ENABLED=true
GRE_CLAUDE_MODEL=claude-opus-5-5

# --- Database -----------------------------------------------------------------
# SECRET (it holds the database password). PostgreSQL only. Supabase: Project →
# Connect, with your database password filled in (percent-encode special
# characters). Migrations run automatically on startup (or `alembic upgrade head`).
#   Direct connection: IPv6 only; fine on a Mac with IPv6, not in Docker or Vercel.
#   Session pooler: works over IPv4, so use it for Docker and hosting.
GRE_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Auth (backend) -------------------------------------------------------------
# "clerk" (the default): verifies Clerk session tokens against Clerk's public
# signing keys, so no Clerk secret key is needed.
# "dev": trusts the X-Dev-User header. Local only; a Vercel deployment refuses it.
GRE_AUTH_MODE=dev
# Clerk dashboard → Configure → API keys → "Frontend API URL":
# GRE_CLERK_ISSUER=https://<your-app>.clerk.accounts.dev
# GRE_CLERK_JWKS_URL=https://<your-app>.clerk.accounts.dev/.well-known/jwks.json
# Origins your frontend is served from (Vercel's own URLs are added automatically):
# GRE_CLERK_AUTHORIZED_PARTIES=["http://localhost:5173"]
# Approved accounts: only these emails may use the app (403 for anyone else,
# including accounts that already exist). Needs the session token to carry
# the email: Clerk dashboard -> Sessions -> claims {"primaryEmail": "{{user.primary_email_address}}"}.
# Empty or unset = any signed-in Clerk user (required on Vercel).
# GRE_ALLOWED_EMAILS=["you@example.com"]

GRE_CORS_ORIGINS=["http://localhost:5173"]

# --- Frontend -----------------------------------------------------------------
# Clerk dashboard → API keys. Public by design (it ends up in the JavaScript).
# Leave empty to run the frontend without sign-in (pair with GRE_AUTH_MODE=dev).
VITE_CLERK_PUBLISHABLE_KEY=
